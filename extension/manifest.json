{
  "manifest_version": 3,
  "name": "LEB2 Tasks Sync",
  "version": "0.4.1",
  "description": "Sync LEB2 assessment deadlines to Google Tasks without storing your LEB2 password.",
  "key": "",
  "permissions": ["alarms", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://app.leb2.org/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LEB2 Tasks Sync",
    "default_popup": "popup.html"
  }
}
